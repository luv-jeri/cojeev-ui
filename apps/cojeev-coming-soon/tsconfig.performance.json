{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "./*"
      ],
      "three": [
        "./apps/cojeev-coming-soon/node_modules/@types/three/index.d.ts"
      ],
      "react": [
        "./apps/cojeev-coming-soon/node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./apps/cojeev-coming-soon/node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./apps/cojeev-coming-soon/node_modules/@types/react-dom/*"
      ]
    }
  },
  "files": [
    "src/bond-demo.tsx",
    "src/prerender.tsx",
    "src/bootstrap.ts",
    "../../registry/cojeev/ui/shader-background.worker.tsx"
  ]
}
