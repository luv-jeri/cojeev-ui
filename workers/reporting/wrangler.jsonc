{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cojeev-ui-reporting",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "25369d7051a3d996a1bca81f462a1fbc",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "feedback.cojeev.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEt12whn6p_17NLe",
    "RELEASE": "unconfigured",
    "ALLOWED_ORIGINS": "https://000h.cojeev.com,https://feedback.cojeev.com,https://luv-jeri.github.io",
    "SITE_URL": "https://000h.cojeev.com",
    "LOCAL_MODE": "false",
    "EMAIL_ENABLED": "false",
    "EMAIL_FROM": "hello@cojeev.com",
    "DELIVERY_ACTIVATED_AT": "",
    "EMAIL_DAILY_LIMIT": "95",
    "EMAIL_MONTHLY_LIMIT": "2850",
    "BETA_TESTER_EMAILS": "",
    "GITHUB_REPOSITORY": "luv-jeri/cojeev-ui"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cojeev-ui-reports",
      "database_id": "056bebac-a74e-403f-8d83-9734870d1ec1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cojeev-ui-report-media"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "env": {
    "beta": {
      "name": "cojeev-ui-reporting-beta",
      "routes": [
        {
          "pattern": "feedback-beta.cojeev.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "beta",
        "RELEASE": "unconfigured",
        "ALLOWED_ORIGINS": "https://beta.000h.cojeev.com,https://feedback-beta.cojeev.com",
        "SITE_URL": "https://beta.000h.cojeev.com",
        "LOCAL_MODE": "false",
        "EMAIL_ENABLED": "false",
        "EMAIL_FROM": "hello@cojeev.com",
        "DELIVERY_ACTIVATED_AT": "",
        "EMAIL_DAILY_LIMIT": "5",
        "EMAIL_MONTHLY_LIMIT": "150",
        "BETA_TESTER_EMAILS": "unread.fyi@gmail.com",
        "GITHUB_REPOSITORY": "luv-jeri/cojeev-ui-beta-feedback"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cojeev-ui-beta-reports",
          "database_id": "e2adf4c4-5ab0-434d-b90f-96ea451e3be7",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cojeev-ui-beta-report-media"
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    },
    "production": {
      "name": "cojeev-ui-reporting",
      "routes": [
        {
          "pattern": "feedback.cojeev.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEt12whn6p_17NLe",
        "RELEASE": "unconfigured",
        "ALLOWED_ORIGINS": "https://000h.cojeev.com,https://feedback.cojeev.com,https://luv-jeri.github.io",
        "SITE_URL": "https://000h.cojeev.com",
        "LOCAL_MODE": "false",
        "EMAIL_ENABLED": "false",
        "EMAIL_FROM": "hello@cojeev.com",
        "DELIVERY_ACTIVATED_AT": "",
        "EMAIL_DAILY_LIMIT": "95",
        "EMAIL_MONTHLY_LIMIT": "2850",
        "BETA_TESTER_EMAILS": "",
        "GITHUB_REPOSITORY": "luv-jeri/cojeev-ui"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cojeev-ui-reports",
          "database_id": "056bebac-a74e-403f-8d83-9734870d1ec1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cojeev-ui-report-media"
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  }
}
