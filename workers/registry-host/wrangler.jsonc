{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cojeev-ui-registry",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/r/*"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "25369d7051a3d996a1bca81f462a1fbc",
  "routes": [
    {
      "pattern": "000h.cojeev.com",
      "custom_domain": true
    }
  ]
}
