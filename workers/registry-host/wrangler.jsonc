{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cojeev-ui-registry",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-10",
  "account_id": "25369d7051a3d996a1bca81f462a1fbc",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "000h.cojeev.com",
      "custom_domain": true
    },
    {
      "pattern": "cojeev.com/ui*",
      "zone_name": "cojeev.com"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "RELEASE": "unconfigured",
    "PHASE": "unconfigured",
    "DEPLOYMENT_ID": "unconfigured",
    "MIGRATION_STAGE": "unconfigured",
    "REGISTRY_GRAPH": "unconfigured"
  },
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/*",
      "!/ui/_next/*",
      "!/ui/*.txt",
      "!/ui/brand/*",
      "!/ui/icon.png",
      "!/ui/opengraph-image.png",
      "!/ui/twitter-image.png"
    ],
    "not_found_handling": "404-page"
  },
  "env": {
    "beta": {
      "name": "cojeev-ui-registry-beta",
      "routes": [
        {
          "pattern": "beta.000h.cojeev.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "beta",
        "RELEASE": "unconfigured",
        "PHASE": "unconfigured",
        "DEPLOYMENT_ID": "unconfigured",
        "MIGRATION_STAGE": "unconfigured",
        "REGISTRY_GRAPH": "unconfigured"
      },
      "assets": {
        "directory": "../../out",
        "binding": "ASSETS",
        "run_worker_first": [
          "/*",
          "!/_next/*",
          "!/ui/_next/*",
          "!/ui/*.txt",
          "!/ui/brand/*",
          "!/ui/icon.png",
          "!/ui/opengraph-image.png",
          "!/ui/twitter-image.png"
        ],
        "not_found_handling": "404-page"
      }
    },
    "production": {
      "name": "cojeev-ui-registry",
      "routes": [
        {
          "pattern": "000h.cojeev.com",
          "custom_domain": true
        },
        {
          "pattern": "cojeev.com/ui*",
          "zone_name": "cojeev.com"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "RELEASE": "unconfigured",
        "PHASE": "unconfigured",
        "DEPLOYMENT_ID": "unconfigured",
        "MIGRATION_STAGE": "unconfigured",
        "REGISTRY_GRAPH": "unconfigured"
      },
      "assets": {
        "directory": "../../out",
        "binding": "ASSETS",
        "run_worker_first": [
          "/*",
          "!/_next/*",
          "!/ui/_next/*",
          "!/ui/*.txt",
          "!/ui/brand/*",
          "!/ui/icon.png",
          "!/ui/opengraph-image.png",
          "!/ui/twitter-image.png"
        ],
        "not_found_handling": "404-page"
      },
      "services": [
        {
          "binding": "COJEEV_HOMEPAGE",
          "service": "cojeev-coming-soon"
        }
      ]
    }
  },
  "services": [
    {
      "binding": "COJEEV_HOMEPAGE",
      "service": "cojeev-coming-soon"
    }
  ]
}
