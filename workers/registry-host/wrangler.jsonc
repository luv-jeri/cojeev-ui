{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cojeev-ui-registry",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-10",
  "account_id": "25369d7051a3d996a1bca81f462a1fbc",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "000h.cojeev.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "RELEASE": "unconfigured"
  },
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "env": {
    "beta": {
      "name": "cojeev-ui-registry-beta",
      "routes": [
        {
          "pattern": "beta.000h.cojeev.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "beta",
        "RELEASE": "unconfigured"
      },
      "assets": {
        "directory": "../../out",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page"
      }
    },
    "production": {
      "name": "cojeev-ui-registry",
      "routes": [
        {
          "pattern": "000h.cojeev.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "RELEASE": "unconfigured"
      },
      "assets": {
        "directory": "../../out",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page"
      }
    }
  }
}
