# Canonical origin used to remove the deployment base path from analytics routes.
NEXT_PUBLIC_SITE_URL=https://luv-jeri.github.io/cojeev-ui

# Match the canonical origin when attaching a domain; rebuild the registry and site.
NEXT_PUBLIC_REGISTRY_URL=https://luv-jeri.github.io/cojeev-ui
COJEEV_REGISTRY_URL=https://luv-jeri.github.io/cojeev-ui
# For a separate root-domain build, set COJEEV_BASE_PATH to an empty string.

# Release identity. "beta" adds the beta stamp and keeps the build out of search results.
# The release SHA must be a 40-character commit hash; anything else is ignored.
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=
NEXT_PUBLIC_RELEASE_SHA=

# Reporting and feedback service. Leave blank to keep drafts on the device only.
NEXT_PUBLIC_REPORTING_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Publish the verified contact address on the creator page. Only set this to true
# after a real message has actually been received at that address.
NEXT_PUBLIC_CONTACT_ENABLED=false

# PostHog public capture settings. Never put a personal/private API key here.
# Project 272306 is EU Cloud; the US host stays permitted only for older test fixtures.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# The only switch that enables capture. Anything but "true" — including unset —
# disables analytics in every build, production included.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
