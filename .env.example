# Canonical origin used to remove the deployment base path from analytics routes.
NEXT_PUBLIC_SITE_URL=https://luv-jeri.github.io/cojeev-ui

# Match the canonical origin when attaching a domain; rebuild the registry and site.
NEXT_PUBLIC_REGISTRY_URL=https://luv-jeri.github.io/cojeev-ui
COJEEV_REGISTRY_URL=https://luv-jeri.github.io/cojeev-ui
# For a separate root-domain build, set COJEEV_BASE_PATH to an empty string.

# PostHog public capture settings. Never put a personal/private API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Required for development, tests, and loopback hosts. Production needs only valid settings above.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
