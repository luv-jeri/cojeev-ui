{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button",
  "title": "Button",
  "description": "Button with SahaJiv variants and sizing.",
  "dependencies": [],
  "registryDependencies": [
    "https://luv-jeri.github.io/sahajiv-ui/r/sahajiv.json"
  ],
  "files": [
    {
      "path": "registry/sahajiv/ui/button.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { useFlowPress } from \"@/lib/sahajiv-motion/flow-press\"\nimport { useMorph } from \"@/lib/sahajiv-motion/use-morph\"\nimport { cva, type VariantProps } from \"class-variance-authority\"\nimport { cn } from \"@/lib/utils\"\n\nconst buttonVariants = cva(\n  \"v-btn inline-flex items-center justify-center gap-[var(--s-2)] h-[var(--ctl-md)] px-[var(--s-5)] py-0 rounded-[var(--r-pill)] text-[length:var(--fs-control)] font-[number:var(--fw-control)] leading-none whitespace-nowrap bg-[var(--primary)] text-[color:var(--primary-foreground)] motion-safe:active:[transform:translateY(1px)]\",\n  {\n    variants: {\n      variant: {\n        default: \"\",\n        accent: \"-accent bg-[var(--v-pink)] text-[color:var(--v-on-accent)] hover:bg-[var(--v-pink-deep)]\",\n        secondary: \"-secondary bg-[var(--v-beige)] text-[color:var(--v-text)] [box-shadow:inset_0_0_0_1px_var(--v-text-2)] hover:[box-shadow:inset_0_0_0_1px_var(--v-text)]\",\n        ghost: \"-ghost bg-transparent text-[color:var(--v-text)] hover:bg-[var(--v-beige)]\",\n        outline: \"-outline bg-transparent text-[color:var(--v-text)] [box-shadow:inset_0_0_0_1px_var(--v-border)] hover:bg-[var(--v-beige-2)]\",\n        danger: \"-danger bg-[var(--v-danger-fill)] text-[color:var(--destructive-foreground)]\",\n        block: \"-block w-full\",\n      },\n      size: {\n        default: \"\",\n        sm: \"-sm h-[var(--ctl-sm)] px-[var(--s-4)] text-[13px]\",\n        lg: \"-lg h-[var(--ctl-lg)] px-[var(--s-6)] text-[length:var(--fs-body)]\",\n      },\n      fullWidth: { true: \"-block w-full\", false: \"\" },\n    },\n    defaultVariants: { variant: \"default\", size: \"default\", fullWidth: false },\n  },\n)\n\ntype ButtonProps = React.ComponentProps<\"button\"> & VariantProps<typeof buttonVariants> & {\n  loading?: boolean\n  loadingIndicator?: React.ReactNode\n}\n\nfunction Button({ ref: externalRef, className, variant, size, fullWidth, loading, loadingIndicator, children, type = \"button\", \"aria-busy\": ariaBusy, ...props }: ButtonProps) {\n  const morphRef = useMorph<HTMLButtonElement>(\"buttons\", externalRef)\n  const pressRef = useFlowPress(morphRef)\n  const busy = loading ?? (ariaBusy === true || ariaBusy === \"true\")\n  return (\n    <button ref={pressRef} data-slot=\"button\" data-part=\"root\" data-state={props.disabled ? \"disabled\" : busy ? \"busy\" : \"rest\"} type={type} aria-busy={busy || undefined} className={cn(buttonVariants({ variant, size, fullWidth }), \"leading-none\", className)} {...props}>\n      {busy && (loadingIndicator ?? <ButtonIndicator />)}\n      {children}\n    </button>\n  )\n}\n\nfunction ButtonIndicator({ ref:externalRef, className, ...props }: React.ComponentProps<\"span\">) {\n  const morphRef=useMorph<HTMLSpanElement>(\"skeleton\",externalRef)\n  return <span ref={morphRef} data-slot=\"button-indicator\" data-part=\"indicator\" data-label=\"\" aria-hidden=\"true\" className={cn(\"v-pulse\", className)} {...props} />\n}\n\nexport { Button, ButtonIndicator, buttonVariants }\nexport type { ButtonProps }\n",
      "type": "registry:ui"
    }
  ],
  "css": {
    "@layer sahajiv-states": {
      "[data-slot=\"button\"]": {
        "transition": "background var(--t-micro) var(--enter), transform var(--t-micro) var(--enter), opacity var(--t-micro)"
      },
      "[data-slot=\"button\"]:not(.-accent):not(.-secondary):not(.-ghost):not(.-outline):not(.-danger):hover": {
        "background": "color-mix(in oklab, var(--primary) 88%, var(--v-canvas))"
      },
      "[data-slot=\"button\"].-secondary:hover": {
        "background": "color-mix(in oklab, var(--v-beige) 92%, var(--v-ink))"
      },
      "[data-slot=\"button\"].-danger:hover": {
        "background": "color-mix(in oklab, var(--v-danger-fill) 88%, black)"
      },
      ":root[data-mode=\"dark\"] [data-slot=\"button\"]:not(.-accent):not(.-secondary):not(.-ghost):not(.-outline):not(.-danger)": {
        "background": "var(--v-pink)",
        "color": "var(--v-on-accent)"
      },
      "[data-slot=\"button\"]:is(:disabled, [aria-disabled=\"true\"])": {
        "background": "var(--v-disabled-face)",
        "color": "var(--v-disabled-ink)",
        "box-shadow": "inset 0 0 0 1px var(--v-disabled-edge)",
        "cursor": "not-allowed",
        "transform": "none"
      },
      ":root[data-mode=\"dark\"] [data-slot=\"button\"]:is(.-secondary,.-ghost,.-outline)": {
        "color": "var(--v-text)"
      },
      "[data-slot=\"button\"] .v-icon": {
        "width": "18px",
        "height": "18px"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"]": {
        "position": "relative",
        "overflow": "hidden",
        "cursor": "progress",
        "pointer-events": "none",
        "gap": "10px"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"] .v-pulse": {
        "display": "inline-grid",
        "place-items": "center",
        "position": "relative",
        "width": "20px",
        "height": "20px"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"] .v-pulse svg": {
        "width": "100%",
        "height": "100%",
        "overflow": "visible"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"] .v-pulse .seed": {
        "fill": "var(--v-pink)"
      },
      "[data-slot=\"button\"]:is(.-secondary,.-ghost,.-outline)[aria-busy=\"true\"] .v-pulse .seed": {
        "fill": "var(--v-brand)"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"] .v-pulse .core": {
        "fill": "var(--v-canvas)"
      },
      "[data-slot=\"button\"]:is(.-secondary,.-ghost,.-outline)[aria-busy=\"true\"] .v-pulse .core,\n:root[data-mode=\"dark\"] [data-slot=\"button\"][aria-busy=\"true\"] .v-pulse .core": {
        "fill": "var(--v-on-accent)"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"]::after": {
        "content": "\"\"",
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(100deg, transparent 20%, rgba(251,244,230,.14) 50%, transparent 80%)",
        "transform": "translateX(-100%)",
        "animation": "v-button-sweep 2.2s cubic-bezier(.4,0,.2,1) infinite",
        "pointer-events": "none"
      },
      "[data-slot=\"button\"]:is(.-secondary,.-ghost,.-outline)[aria-busy=\"true\"]::after": {
        "background": "linear-gradient(100deg, transparent 20%, rgba(17,17,17,.06) 50%, transparent 80%)"
      },
      "[data-slot=\"button\"][aria-busy=\"true\"] > :not(.v-pulse)": {
        "position": "relative",
        "z-index": "1",
        "opacity": ".85"
      },
      "@keyframes v-button-sweep": {
        "to": {
          "transform": "translateX(100%)"
        }
      },
      "@media (prefers-reduced-motion: reduce)": {
        "[data-slot=\"button\"][aria-busy=\"true\"]::after": {
          "animation": "none",
          "display": "none"
        }
      }
    }
  },
