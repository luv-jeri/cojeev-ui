{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "direction",
  "title": "Direction",
  "description": "Sets a text direction for a subtree and shares it with direction-aware primitives.",
  "dependencies": [
    "@radix-ui/react-direction"
  ],
  "registryDependencies": [
    "https://luv-jeri.github.io/cojeev-ui/r/cojeev.json"
  ],
  "files": [
    {
      "path": "registry/cojeev/ui/direction.tsx",
      "content": "\"use client\"\nimport * as React from \"react\"\nimport { DirectionProvider } from \"@radix-ui/react-direction\"\nexport type DirectionProps=React.ComponentProps<\"div\"> & { dir?:\"ltr\"|\"rtl\" }\nexport function Direction({dir=\"rtl\",children,...props}:DirectionProps){return <DirectionProvider dir={dir}><div data-slot=\"direction\" dir={dir} {...props}>{children}</div></DirectionProvider>}\nexport { DirectionProvider }\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/cojeev/styles/direction.css",
      "content": "@layer cojeev-states {\n/* Direction is inherited through the DOM and Radix context. Brand geometry is never mirrored. */\n[data-slot=\"direction\"]{text-align:start}\n\n}\n",
      "type": "registry:file",
      "target": "styles/cojeev/direction.css"
    }
  ],
  "css": {
    "@import \"@/styles/cojeev/direction.css\"": {}
  },
  "meta": {
    "source": {
      "id": "direction",
      "name": "Direction",
      "tier": "base",
      "evidence": "Ext",
      "status": "derived",
      "root": "[dir=rtl]",
      "variants": [],
      "sizes": [],
      "states": [
        "rest",
        "hover",
        "focus",
        "active",
        "selected"
      ],
      "dataStates": [],
      "category": "none",
      "motionOnByDefault": false,
      "flowRoles": [],
      "canvas": "480x240",
      "contract": "entries/direction/contract.md",
      "demo": "entries/direction/demo.html",
      "isolation": [
        "default-default-rest.html",
        "default-default-rest-dark.html",
        "default-default-selected.html",
        "default-default-selected-dark.html"
      ]
    },
    "api": [
      {
        "name": "DirectionProps",
        "props": [
          {
            "name": "dir",
            "type": "string | undefined",
            "required": false,
            "description": ""
          }
        ]
      }
    ],
    "category": "Layout",
    "fidelity": "refined-design-family",
    "baseComponent": true
  },
  "type": "registry:ui"
}
