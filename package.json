{
  "name": "cojeev-ui",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "vite preview --outDir out --base /cojeev-ui/ --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "gate": "node scripts/run-production-gate.mjs",
    "gate:spike": "node apps/gate/run.mjs --components=button,badge,card",
    "gate:dev": "vite --config apps/gate/vite.config.ts --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "node scripts/lint.mjs",
    "gate:static": "node apps/gate/run.mjs",
    "gate:interactions": "node scripts/gate-interactions.mjs",
    "gate:lifecycle": "node scripts/gate-lifecycle.mjs",
    "gate:reference": "npm run gate:static && npm run gate:interactions && npm run gate:lifecycle && node scripts/append-gate-report.mjs",
    "gate:docs": "node scripts/check-docs.mjs --serve --output=artifacts/production-docs",
    "gate:motion": "node --import tsx scripts/check-motion.mjs --serve",
    "check:examples": "node scripts/check-example-source.mjs",
    "gate:mobile": "node scripts/check-mobile-webkit.mjs --serve --output=artifacts/mobile-webkit",
    "gate:marketing": "node scripts/check-refinement-marketing.mjs --serve",
    "gate:smooth-scroll": "node scripts/check-landing-smooth-scroll.mjs --serve",
    "reporting:dev": "node scripts/reporting.mjs dev",
    "reporting:test": "node --test workers/reporting/test/*.test.mjs",
    "reporting:browser": "node scripts/check-reporting-browser.mjs",
    "reporting:deploy": "node scripts/reporting.mjs deploy",
    "reporting:provision": "node scripts/reporting.mjs provision",
    "reporting:check": "npx wrangler deploy --dry-run --config workers/reporting/wrangler.jsonc",
    "analytics:test": "node --import tsx --test tests/analytics.test.ts tests/github-traffic.test.ts",
    "analytics:browser": "node tests/analytics.browser.mjs",
    "analytics:github": "node scripts/snapshot-github-traffic.mjs",
    "launch:check": "node scripts/check-launch-readiness.mjs",
    "registry-host:test": "node --test workers/registry-host/test/*.test.mjs",
    "registry-host:types": "wrangler types workers/registry-host/worker-configuration.d.ts --config workers/registry-host/wrangler.jsonc --env-interface RegistryHostEnv --include-runtime false",
    "registry-host:check": "wrangler deploy --dry-run --config workers/registry-host/wrangler.jsonc",
    "launch:browser": "node scripts/check-launch-browser.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.15.8",
    "fumadocs-ui": "16.15.8",
    "input-otp": "^1.5.0",
    "lenis": "1.3.26",
    "lucide-react": "^0.577.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "prettier": "3.6.2",
    "prismjs": "1.30.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "4.21.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.185.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/prismjs": "1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.4",
    "miniflare": "^5.20260908.0-alpha",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wrangler": "^4.130.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
