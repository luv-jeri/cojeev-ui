{
  "name": "sahajiv-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "vite preview --outDir out --base /sahajiv-ui/ --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "gate": "npm run gate:static && npm run gate:interactions && npm run gate:lifecycle && node scripts/append-gate-report.mjs",
    "gate:spike": "node apps/gate/run.mjs --components=button,badge,card",
    "gate:dev": "vite --config apps/gate/vite.config.ts --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "node scripts/lint.mjs",
    "gate:static": "node apps/gate/run.mjs",
    "gate:interactions": "node scripts/gate-interactions.mjs",
    "gate:lifecycle": "node scripts/gate-lifecycle.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.15.8",
    "fumadocs-ui": "16.15.8",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.1.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.4",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
