      "css": ".ds-input{box-sizing:border-box;width:100%;min-width:0;height:48px;padding:0 18px;border:0;border-radius:var(--r-pill,999px);background:var(--input,#EEE7DA);color:var(--v-text,#0E0B0B);font-family:var(--font-text,DM Sans,sans-serif);font-size:var(--fs-body,15px);box-shadow:inset 0 0 0 1px var(--v-edge,#87806F);transition:background var(--t-micro,120ms),box-shadow var(--t-micro,120ms)}.ds-input::placeholder{color:var(--v-text-2,#5F5B55)}.ds-input:hover:not(:focus){background:color-mix(in oklab,var(--input,#EEE7DA) 92%,var(--v-canvas,#FBF4E6))}.ds-input:focus-visible,.ds-input:focus{outline:0;background:var(--v-pink-soft,color-mix(in oklab,var(--v-pink,#F5B8DB) 55%,var(--v-canvas,#FBF4E6)));box-shadow:inset 0 0 0 2px var(--v-brand,#9C3E6E)}:host-context([data-mode=\"dark\"]) .ds-input{background:var(--v-beige,#221F1B);box-shadow:inset 0 0 0 1px var(--v-border,#3A352E)}:host-context([data-mode=\"dark\"]) .ds-input:focus{background:color-mix(in oklab,var(--v-pink,#F5B8DB) 14%,var(--v-canvas,#171512));box-shadow:inset 0 0 0 2px var(--v-pink,#F5B8DB)}.ds-input:disabled{background:var(--v-disabled-face,#EDE6D7);color:var(--v-disabled-ink,#6A635B);box-shadow:inset 0 0 0 1px var(--v-disabled-edge,#877F6F);cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
